<Window x:Class="DofusRetroManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dofus Retro — Window Manager"
        Height="640" Width="860"
        MinHeight="520" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">

    <Window.Resources>

        <!-- ===== Colours ===== -->
        <SolidColorBrush x:Key="NavyBrush"        Color="#1E3A5F"/>
        <SolidColorBrush x:Key="BlueBrush"         Color="#2196F3"/>
        <SolidColorBrush x:Key="LightBlueBrush"    Color="#E3F2FD"/>
        <SolidColorBrush x:Key="GreenBrush"        Color="#4CAF50"/>
        <SolidColorBrush x:Key="RedBrush"          Color="#F44336"/>
        <SolidColorBrush x:Key="SurfaceBrush"      Color="White"/>
        <SolidColorBrush x:Key="BorderBrush"       Color="#E0E0E0"/>
        <SolidColorBrush x:Key="SubTextBrush"      Color="#616161"/>
        <SolidColorBrush x:Key="HintBrush"         Color="#9E9E9E"/>

        <!-- ===== Button base ===== -->
        <Style x:Key="BaseBtn" TargetType="Button">
            <Setter Property="Foreground"    Value="White"/>
            <Setter Property="Padding"       Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnBlue"  TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="#2196F3"/>
        </Style>
        <Style x:Key="BtnGreen" TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="#4CAF50"/>
        </Style>
        <Style x:Key="BtnRed"   TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="#F44336"/>
        </Style>
        <Style x:Key="BtnGrey"  TargetType="Button" BasedOn="{StaticResource BaseBtn}">
            <Setter Property="Background" Value="#78909C"/>
        </Style>

        <!-- ===== Card border ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"       Value="White"/>
            <Setter Property="CornerRadius"     Value="8"/>
            <Setter Property="BorderBrush"      Value="#E0E0E0"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="16"/>
        </Style>

        <!-- ===== TextBox ===== -->
        <Style TargetType="TextBox">
            <Setter Property="Padding"          Value="8,6"/>
            <Setter Property="BorderBrush"      Value="#BDBDBD"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ===== TabItem ===== -->
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ================================================================
             Header
             ================================================================ -->
        <Border Grid.Row="0" Background="{StaticResource NavyBrush}">
            <Grid Margin="16,0">
                <!-- Left: logo + title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚔" FontSize="26" Foreground="#FFD700"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Dofus Retro" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Window Manager" FontSize="11" Foreground="#90CAF9"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: action buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,4,0">
                    <Button Command="{Binding ToggleMonitoringCommand}"
                            Content="{Binding MonitoringButtonText}"
                            Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BaseBtn}">
                                <Setter Property="Background" Value="#4CAF50"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                        <Setter Property="Background" Value="#EF5350"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="💾 Sauvegarder"
                            Command="{Binding SaveConfigCommand}"
                            Style="{StaticResource BtnBlue}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================================
             Tab control
             ================================================================ -->
        <TabControl Grid.Row="1" Margin="10,8,10,8"
                    Background="White"
                    BorderBrush="#E0E0E0">

            <!-- ============================================================
                 Tab 1 — Characters
                 ============================================================ -->
            <TabItem Header="👤 Personnages">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="270"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: list + order buttons -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Ordre de jeu des personnages"
                                   FontWeight="Bold" FontSize="14"
                                   Margin="0,0,0,8"/>

                        <ListView Grid.Row="1"
                                  x:Name="CharacterListView"
                                  ItemsSource="{Binding Characters}"
                                  SelectedItem="{Binding SelectedCharacter}"
                                  BorderBrush="#E0E0E0"
                                  SelectionMode="Single">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="#" Width="36">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Order}"
                                                           HorizontalAlignment="Center"
                                                           FontWeight="Bold"
                                                           Foreground="#1E3A5F"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Nom" Width="160"
                                                    DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="Filtre titre fenêtre" Width="200"
                                                    DisplayMemberBinding="{Binding WindowTitlePattern}"/>
                                    <GridViewColumn Header="Actif" Width="55">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsActive}"
                                                          HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel Grid.Row="2" Orientation="Horizontal"
                                    Margin="0,8,0,0" HorizontalAlignment="Right">
                            <Button Content="⬆ Monter"    Command="{Binding MoveUpCommand}"
                                    Style="{StaticResource BtnGrey}" Margin="0,0,6,0"/>
                            <Button Content="⬇ Descendre" Command="{Binding MoveDownCommand}"
                                    Style="{StaticResource BtnGrey}" Margin="0,0,6,0"/>
                            <Button Content="🗑 Supprimer" Command="{Binding RemoveCharacterCommand}"
                                    Style="{StaticResource BtnRed}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Right: add character form -->
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Ajouter un personnage"
                                       FontWeight="Bold" FontSize="14"
                                       Margin="0,0,0,14"/>

                            <TextBlock Text="Nom du personnage"
                                       Foreground="{StaticResource SubTextBrush}"
                                       Margin="0,0,0,4" FontSize="12"/>
                            <TextBox Text="{Binding NewCharacterName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10"/>

                            <TextBlock Text="Filtre titre de fenêtre"
                                       Foreground="{StaticResource SubTextBrush}"
                                       Margin="0,0,0,4" FontSize="12"/>
                            <TextBox Text="{Binding NewWindowPattern, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,4"/>
                            <TextBlock Text="Texte unique dans le titre de la fenêtre Dofus&#x0a;(souvent le nom du personnage)."
                                       FontSize="10" Foreground="{StaticResource HintBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <Button Content="+ Ajouter"
                                    Command="{Binding AddCharacterCommand}"
                                    Style="{StaticResource BtnGreen}"
                                    HorizontalAlignment="Stretch"/>

                            <Separator Margin="0,16"/>

                            <TextBlock Text="Filtre fenêtre Dofus"
                                       FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="Texte contenu dans le titre des fenêtres Dofus :"
                                       Foreground="{StaticResource SubTextBrush}"
                                       Margin="0,0,0,4" FontSize="11"/>
                            <TextBox Text="{Binding GameWindowPattern, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,12"/>

                            <Button Content="🔍 Détecter les fenêtres"
                                    Command="{Binding RefreshWindowsCommand}"
                                    Style="{StaticResource BtnBlue}"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================================================
                 Tab 2 — Hotkeys
                 ============================================================ -->
            <TabItem Header="⌨ Raccourcis">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" MaxWidth="520">

                        <TextBlock Text="Configuration des raccourcis clavier"
                                   FontWeight="Bold" FontSize="16"
                                   Margin="0,0,0,20"/>

                        <!-- Hotkey card -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Passer à la fenêtre suivante"
                                           FontWeight="Bold" FontSize="14"
                                           Margin="0,0,0,14"/>

                                <TextBlock Text="Modificateurs"
                                           Foreground="{StaticResource SubTextBrush}"
                                           Margin="0,0,0,8" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <CheckBox Content="Ctrl"  IsChecked="{Binding HotkeyCtrl}"
                                              Margin="0,0,20,0" VerticalAlignment="Center"/>
                                    <CheckBox Content="Alt"   IsChecked="{Binding HotkeyAlt}"
                                              Margin="0,0,20,0" VerticalAlignment="Center"/>
                                    <CheckBox Content="Shift" IsChecked="{Binding HotkeyShift}"
                                              VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="Touche"
                                           Foreground="{StaticResource SubTextBrush}"
                                           Margin="0,0,0,8" FontSize="12"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="HotkeyTextBox"
                                             Grid.Column="0"
                                             Text="{Binding HotkeySetting}"
                                             Background="{StaticResource LightBlueBrush}"
                                             IsReadOnly="True"
                                             Cursor="Hand"
                                             ToolTip="Cliquez ici puis appuyez sur une touche"
                                             PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                             GotFocus="HotkeyTextBox_GotFocus"
                                             LostFocus="HotkeyTextBox_LostFocus"/>
                                    <TextBlock Grid.Column="1"
                                               Text="← cliquez et appuyez sur une touche"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"
                                               Foreground="{StaticResource HintBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                </Grid>

                                <Button Content="✓ Appliquer le raccourci"
                                        Command="{Binding ApplyHotkeyCommand}"
                                        Style="{StaticResource BtnGreen}"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- Info box -->
                        <Border Background="#E8F5E9" CornerRadius="8" Padding="14"
                                BorderBrush="#A5D6A7" BorderThickness="1"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="ℹ  Fonctionnement"
                                           FontWeight="Bold" Margin="0,0,0,8"
                                           Foreground="#2E7D32"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#388E3C" FontSize="12"
                                           LineHeight="18">
Le raccourci est global : il fonctionne même quand l'application n'est pas au premier plan.
Il fait défiler les personnages actifs dans l'ordre configuré dans l'onglet « Personnages ».
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Separator Margin="0,4,0,16"/>

                        <!-- Auto-swap card -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Auto-swap sur notification"
                                           FontWeight="Bold" FontSize="14"
                                           Margin="0,0,0,10"/>
                                <CheckBox Content="Activer le swap automatique lors des notifications"
                                          IsChecked="{Binding AutoSwapEnabled}"
                                          Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{StaticResource SubTextBrush}"
                                           FontSize="11" LineHeight="16">
Quand activé, la fenêtre Dofus change automatiquement dès qu'une notification de
début de tour, invitation de groupe ou échange est détectée dans le titre de la fenêtre.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================
                 Tab 3 — Windows
                 ============================================================ -->
            <TabItem Header="🪟 Fenêtres">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Fenêtres Dofus détectées"
                                   FontWeight="Bold" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Button Content="🔄 Rafraîchir"
                                Command="{Binding RefreshWindowsCommand}"
                                Style="{StaticResource BtnBlue}"/>
                    </StackPanel>

                    <ListView Grid.Row="1"
                              x:Name="WindowsListView"
                              ItemsSource="{Binding DetectedWindows}"
                              BorderBrush="#E0E0E0"
                              MouseDoubleClick="WindowsListView_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Titre de la fenêtre" Width="380"
                                                DisplayMemberBinding="{Binding Title}"/>
                                <GridViewColumn Header="Processus" Width="140"
                                                DisplayMemberBinding="{Binding ProcessName}"/>
                                <GridViewColumn Header="Handle" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding HandleHex}"
                                                       FontFamily="Consolas" FontSize="11"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <TextBlock Grid.Row="2"
                               Text="Double-cliquez sur une ligne pour basculer vers cette fenêtre"
                               Foreground="{StaticResource HintBrush}"
                               FontSize="11" Margin="0,6,0,0"/>
                </Grid>
            </TabItem>

            <!-- ============================================================
                 Tab 4 — Log
                 ============================================================ -->
            <TabItem Header="📋 Journal">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Journal d'activité"
                                   FontWeight="Bold" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Button Content="🗑 Vider" Command="{Binding ClearLogCommand}"
                                Style="{StaticResource BtnRed}"/>
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding LogEntries}"
                             FontFamily="Consolas"
                             FontSize="12"
                             Background="#1E1E1E"
                             Foreground="#D4D4D4"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingStackPanel.IsVirtualizing="True"/>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ================================================================
             Status bar
             ================================================================ -->
        <Border Grid.Row="2" Background="{StaticResource NavyBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                <!-- Monitoring indicator dot -->
                <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#616161"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                    <Setter Property="Fill" Value="#4CAF50"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="White" FontSize="11"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
